diff --git a/orders-analytics/java/pricing/src/main/java/com/example/orders/pricing/PriceCalculator.java b/orders-analytics/java/pricing/src/main/java/com/example/orders/pricing/PriceCalculator.java
index 2ce4357..8381317 100644
--- a/orders-analytics/java/pricing/src/main/java/com/example/orders/pricing/PriceCalculator.java
+++ b/orders-analytics/java/pricing/src/main/java/com/example/orders/pricing/PriceCalculator.java
@@ -8,6 +8,10 @@ import java.util.Map;
 /** Prices order lines from a catalogue of unit prices. */
 public final class PriceCalculator {
 
+    /** Lines of this many units or more get the volume discount. */
+    static final int VOLUME_DISCOUNT_UNITS = 100;
+    static final double VOLUME_DISCOUNT_RATE = 0.05;
+
     private final Map<String, BigDecimal> unitPrices;
 
     public PriceCalculator(Map<String, BigDecimal> unitPrices) {
@@ -18,7 +22,7 @@ public final class PriceCalculator {
         this(UnitPrices.CATALOGUE);
     }
 
-    /** Unit price times units, rounded half-even to 2 places. */
+    /** Unit price times units, less the volume discount, rounded half-even to 2 places. */
     public BigDecimal lineTotal(OrderLine line) {
         return rawLineTotal(line).setScale(2, RoundingMode.HALF_EVEN);
     }
@@ -40,6 +44,10 @@ public final class PriceCalculator {
         if (price == null) {
             throw new IllegalArgumentException("unknown sku: " + line.sku());
         }
-        return price.multiply(BigDecimal.valueOf(line.units()));
+        double total = price.doubleValue() * line.units();
+        if (line.units() > VOLUME_DISCOUNT_UNITS) {
+            total = total * (1 - VOLUME_DISCOUNT_RATE);
+        }
+        return BigDecimal.valueOf(total);
     }
 }
